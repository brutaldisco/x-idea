    "next": "16.3.4",
    "pino": "^9.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulidx": "^2.4.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"

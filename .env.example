# 本番 URL は https://x-idea.vercel.app
# 有料プラン用キーは未契約なら空のまま。Settings トグルは既定 OFF。

TURSO_DATABASE_URL=libsql://x-idea-brutaldisco.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
X_REDIRECT_URI=https://x-idea.vercel.app/api/x/oauth/callback

GEMINI_API_KEY=

CRON_SECRET=
APP_URL=https://x-idea.vercel.app
SESSION_SECRET=

# 任意。未設定ならゲートなし
APP_PASSCODE=

# P2。契約不要。npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 有料。トグル OFF のあいだ未使用
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=

ARTICLE_FETCH_UA=MarginaliaBot/1.0 (+https://x-idea.vercel.app)
MOCK_EXTERNAL=0
LOG_LEVEL=info

# ローカル実行時のメディア保存先（既定 ./data/media）。Vercel では設定しない
MEDIA_ROOT=
